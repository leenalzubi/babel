{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/github-models.js": {
      "maxDuration": 300
    },
    "api/github-models-embeddings.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
